<Window x:Class="DaatAharon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="דעת אהרן" Height="820" Width="1380" MinHeight="620" MinWidth="980"
        FlowDirection="RightToLeft" Background="#F3F5F9" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="דעת אהרן" FontSize="26" FontWeight="Bold" Foreground="#17243B" />
                    <TextBlock Text="מרכז הקישורים" Margin="0,3,0,18" Foreground="#667085" />
                    <TextBlock Text="פרטי קישור" FontWeight="SemiBold" />
                    <TextBox x:Name="TitleInput" Margin="0,6,0,8" Height="36" Padding="8" ToolTip="שם הקישור" />
                    <TextBox x:Name="UrlInput" Margin="0,0,0,8" Height="36" Padding="8" FlowDirection="LeftToRight" ToolTip="https://example.com" />
                    <TextBox x:Name="CategoryInput" Margin="0,0,0,10" Height="36" Padding="8" Text="כללי" ToolTip="קטגוריה" />
                    <Button Content="הוסף קישור" Height="38" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Click="AddLink_Click" />
                    <Button Content="שמור שינויים בקישור מסומן" Height="36" Margin="0,6,0,0" Click="UpdateLink_Click" />
                    <TextBlock Text="הקישורים שלי" FontSize="17" FontWeight="SemiBold" Margin="0,22,0,8" />
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="מחק קישור מסומן" Height="36" Margin="0,10,0,0" Click="DeleteLink_Click" />
                <ListBox x:Name="LinksList" ItemsSource="{Binding Links}" SelectedItem="{Binding SelectedLink}" BorderThickness="0" SelectionChanged="LinksList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,2" Background="#F6F8FC" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#17243B" />
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#667085" />
                                    <TextBlock Text="{Binding Url}" FontSize="10" Foreground="#667085" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="BrowserStatus" Text="בחר קישור כדי לפתוח אותו כאן" Margin="8" Foreground="#667085" />
                <wv2:WebView2 x:Name="Browser" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
